{
  "name": "memory-aids",
  "productName": "Memory Aids",
  "version": "1.0.0",
  "description": "Turn study notes into visual memory aids.",
  "main": "main.js",
  "author": "Memory Aids",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.memoryaids.windows",
    "productName": "Memory Aids",
    "files": [
      "main.js",
      "preload.js",
      "generator.js",
      "shared/**",
      "renderer/**",
      "assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memory Aids",
      "artifactName": "MemoryAids-Setup.exe"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}